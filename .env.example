# Modèle de configuration. Copier ce fichier en ".env" puis adapter les valeurs.
# Le fichier ".env" ne doit JAMAIS être commité (il est dans .gitignore).
# Ce fichier-ci ne contient que des valeurs factices et peut être versionné.

# --- Application ---
APP_NAME=Talent Intelligence Platform
# Valeurs possibles : development | test | production
ENVIRONMENT=development
# Valeurs possibles : DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Import de CV ---
# Dossier de stockage des fichiers (par défaut data/uploads, ignoré par Git).
# UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=5
MAX_PDF_PAGES=30

# --- Embeddings (recherche par le sens) ---
# none (défaut)          : désactivé ; la recherche par mots-clés et le matching fonctionnent.
# sentence_transformers  : modèle multilingue LOCAL (aucune donnée ne quitte la machine).
#                          Nécessite `pip install -r requirements-ml.txt` (~1 Go) ; le modèle
#                          (~450 Mo) est téléchargé au premier usage.
# hashing                : doublure lexicale pour les tests, PAS de sémantique.
EMBEDDING_PROVIDER=none
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- LLM (facultatif, DÉSACTIVÉ par défaut) ---
# Activer envoie du texte de CV (anonymisé : sans nom, e-mail, téléphone ni lien) à un service
# EXTERNE, et seulement quand l'appelant confirme chaque requête (confirm_external_processing).
# none | gemini | mistral | groq. Les clés ne vont JAMAIS dans le code, Git ou les journaux.
LLM_PROVIDER=none
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# Modèle à utiliser (sinon valeur par défaut du fournisseur, NON vérifiée comme économique).
# LLM_MODEL=
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_INPUT_CHARS=12000

# --- Matching ---
# Poids par défaut du score (relatifs : seuls les rapports comptent). Facultatif.
# MATCHING_WEIGHTS={"skills": 0.45, "experience": 0.20, "tfidf": 0.20, "keyword": 0.10, "education": 0.05}

# --- PostgreSQL ---
# 127.0.0.1 et non "localhost" (évite un blocage IPv6 sous Windows avec Docker).
POSTGRES_HOST=127.0.0.1
# Port côté machine hôte (5433 pour ne pas entrer en conflit avec un Postgres local)
POSTGRES_PORT=5433
POSTGRES_DB=talent_platform
POSTGRES_USER=talent_user
# OBLIGATOIRE : valeur factice, à remplacer dans ton .env local.
POSTGRES_PASSWORD=change_me

# --- Authentification (JWT) ---
# OBLIGATOIRE : secret de signature des jetons. Générer une vraie valeur avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_generate_a_long_random_value
JWT_ALGORITHM=HS256
# Durée de validité d'un jeton, en minutes (1 à 1440).
ACCESS_TOKEN_EXPIRE_MINUTES=30
